<UserControl x:Class="LibraryManagementSystem.BorrowersControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: Search + Add button -->
        <Grid Grid.Row="0" Margin="0,0,189,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8 0"
                    Margin="0 0 10 0">
                <TextBox x:Name="txtSearch"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Height="32"
                         FontSize="12"
                         Foreground="#374151"
                         TextChanged="txtSearch_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Search name, ID, course..."
                                                               Foreground="#9CA3AF"
                                                               FontSize="12"
                                                               Margin="2 0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>

            <Button x:Name="btnAdd"
                    Grid.Column="1"
                    Content="+ Add Borrower"
                    Height="34"
                    Padding="16 0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#178AE5"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnAdd_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1279CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Inline Form (hidden by default) -->
        <Border x:Name="pnlForm"
                Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20"
                Margin="0 0 0 14"
                Visibility="Collapsed">
            <StackPanel>

                <TextBlock x:Name="lblFormTitle"
                           Text="Add Borrower"
                           FontSize="14"
                           FontWeight="Bold"
                           Foreground="#1E2840"
                           Margin="0 0 0 16"/>

                <!-- Row 1: User ID, Full Name, Course -->
                <Grid Margin="0 0 0 10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- User ID -->
                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="User ID" FontSize="11" Foreground="#6B7280" Margin="0 0 0 4"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="txtUserId"
                                     Height= "30"
                                     FontSize="12"
                                     Padding="8 0"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Full Name -->
                    <StackPanel Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="Full Name" FontSize="11" Foreground="#6B7280" Margin="0 0 0 4"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="txtFullName"
                                     Height= "30"
                                     FontSize="12"
                                     Padding="8 0"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Course -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Course" FontSize="11" Foreground="#6B7280" Margin="0 0 0 4"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="txtCourse"
                                     Height= "30"
                                     FontSize="12"
                                     Padding="8 0"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Year Level, Email -->
                <!-- Row 2: Type, Year Level, Email -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Type -->
                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Type" FontSize="11" Foreground="#6B7280" Margin="0 0 0 4"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                            <ComboBox x:Name="cmbType"
                                      Height= "30"
                                      FontSize="12"
                                      BorderThickness="0"
                                      VerticalContentAlignment="Center"
                                      Padding="6 0"
                                      SelectionChanged="cmbType_SelectionChanged">
                                <ComboBoxItem Content="Student" IsSelected="True"/>
                                <ComboBoxItem Content="Teacher"/>
                                <ComboBoxItem Content="Staff"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- Year Level (Student only) -->
                    <StackPanel x:Name="pnlYearLevel" Grid.Column="1" Margin="0 0 10 0">
                        <TextBlock Text="Year Level" FontSize="11" Foreground="#6B7280" Margin="0 0 0 4"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                            <ComboBox x:Name="cmbYearLevel"
                                      Height= "30"
                                      FontSize="12"
                                      BorderThickness="0"
                                      VerticalContentAlignment="Center"
                                      Padding="6 0">    
                                <ComboBoxItem Content="1st Year"/>
                                <ComboBoxItem Content="2nd Year"/>
                                <ComboBoxItem Content="3rd Year"/>
                                <ComboBoxItem Content="4th Year"/>
                            </ComboBox>
                        </Border>
                    </StackPanel>

                    <!-- Email — now correctly on Column 2 -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Email" FontSize="11" Foreground="#6B7280" Margin="0 0 0 4"/>
                        <Border BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4">
                            <TextBox x:Name="txtEmail"
                                     Height="30" FontSize="12"
                                     Padding="8 0"
                                     BorderThickness="0"
                                     VerticalContentAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Form buttons -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0 16 0 0">
                    <Button Content="Cancel"
                            Width="80" Height="32"
                            FontSize="12"
                            Background="White"
                            BorderBrush="#D1D5DB"
                            BorderThickness="1"
                            Margin="0 0 8 0"
                            Cursor="Hand"
                            Click="btnCancel_Click"/>
                    <Button Content="Save"
                            Width="80" Height="32"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Background="#178AE5"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="btnSave_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="5" Padding="4">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1279CC"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

            </StackPanel>
        </Border>

        <!-- Table -->
        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="dgBorrowers"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      FontSize="12"
                      ColumnHeaderHeight="38"
                      RowHeight="40">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9FAFB"/>
                        <Setter Property="Foreground" Value="#6B7280"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12 0"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0 0 0 1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12 0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="User/Student ID" Binding="{Binding user_id}"    Width="120"/>
                    <DataGridTextColumn Header="Type"            Binding="{Binding type}"       Width="90"/>
                    <DataGridTextColumn Header="Full Name"       Binding="{Binding full_name}"  Width="*"/>
                    <DataGridTextColumn Header="Course"          Binding="{Binding course}"     Width="100"/>
                    <DataGridTextColumn Header="Year Level"      Binding="{Binding year_level}" Width="90"/>
                    <DataGridTextColumn Header="Email"           Binding="{Binding email}"      Width="2*"/>
                    <DataGridTemplateColumn Header="Status" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4"
                                        Padding="6 2"
                                        HorizontalAlignment="Left"
                                        Margin="8 0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#DCFCE7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding is_active}" Value="0">
                                                    <Setter Property="Background" Value="#F3F4F6"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Active"/>
                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding is_active}" Value="0">
                                                        <Setter Property="Text" Value="Inactive"/>
                                                        <Setter Property="Foreground" Value="#6B7280"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Actions" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8 0">
                                    <Button Content="Edit"
                                            Width="60" Height="24"
                                            FontSize="11"
                                            Foreground="White"
                                            Background="#178AE5"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Margin="0 0 6 0"
                                            Tag="{Binding id}"
                                            Click="btnEdit_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="4 0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#1279CC"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button Content="Delete"
                                            Width="60" Height="24"
                                            FontSize="11"
                                            Foreground="White"
                                            Background="#EF4444"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            Tag="{Binding id}"
                                            Click="btnDelete_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="4 0">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#DC2626"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>