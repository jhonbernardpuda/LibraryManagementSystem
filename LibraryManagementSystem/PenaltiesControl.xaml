<UserControl x:Class="LibraryManagementSystem.PenaltiesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Summary Cards -->
        <Grid Grid.Row="0" Margin="0 0 0 16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Overdue Records -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0 0 10 0">
                <StackPanel>
                    <TextBlock Text="OVERDUE RECORDS" FontSize="10" Foreground="#6B7280"
                               FontWeight="SemiBold" Margin="0 0 0 6"/>
                    <TextBlock x:Name="lblOverdueCount" Text="0"
                               FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                </StackPanel>
            </Border>

            <!-- Total Penalty -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="8" Padding="16" Margin="0 0 10 0">
                <StackPanel>
                    <TextBlock Text="TOTAL PENALTY OWED" FontSize="10" Foreground="#6B7280"
                               FontWeight="SemiBold" Margin="0 0 0 6"/>
                    <TextBlock x:Name="lblTotalPenalty" Text="₱0.00"
                               FontSize="28" FontWeight="Bold" Foreground="#DC2626"/>
                </StackPanel>
            </Border>

            <!-- Penalty Rate (editable) -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E5E7EB"
                    BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel>
                    <TextBlock Text="PENALTY RATE" FontSize="10" Foreground="#6B7280"
                               FontWeight="SemiBold" Margin="0 0 0 6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="txtRate"
                                 FontSize="22" FontWeight="Bold"
                                 Foreground="#1E2840"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="Save"
                                Height="28" Padding="10 0"
                                FontSize="11" FontWeight="SemiBold"
                                Foreground="White" Background="#178AE5"
                                BorderThickness="0" Cursor="Hand"
                                Click="btnSaveRate_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1279CC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock Text="per day" FontSize="11" Foreground="#6B7280" Margin="0 2 0 0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Warning -->
        <Border x:Name="pnlWarning" Grid.Row="1"
                Background="#FEF2F2" BorderBrush="#FECACA"
                BorderThickness="1" CornerRadius="6"
                Padding="12 8" Margin="0 0 0 14"
                Visibility="Collapsed">
            <TextBlock Text="⚠ Overdue books may affect students' school clearance."
                       FontSize="12" Foreground="#DC2626"/>
        </Border>

        <!-- Tabs -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 14">
            <Button x:Name="btnTabOverdue"
                    Content="Overdue"
                    Height="34" Padding="20 0"
                    FontSize="12" FontWeight="SemiBold"
                    Foreground="White" Background="#178AE5"
                    BorderThickness="0" Cursor="Hand"
                    Click="btnTabOverdue_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5 0 0 5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button x:Name="btnTabHistory"
                    Content="Penalty History"
                    Height="34" Padding="20 0"
                    FontSize="12" FontWeight="SemiBold"
                    Foreground="#6B7280" Background="White"
                    BorderThickness="1" BorderBrush="#D1D5DB"
                    Cursor="Hand"
                    Click="btnTabHistory_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0 5 5 0" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Table -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E5E7EB"
                BorderThickness="1" CornerRadius="8">
            <DataGrid x:Name="dgPenalties"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6"
                      BorderThickness="0" Background="White"
                      RowBackground="White" AlternatingRowBackground="#FAFAFA"
                      FontSize="12" ColumnHeaderHeight="38" RowHeight="36">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9FAFB"/>
                        <Setter Property="Foreground" Value="#6B7280"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12 0"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0 0 0 1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12 0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#FFF1F2"/>
                                <Setter Property="Foreground" Value="#9F1239"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Student"      Binding="{Binding full_name}"   Width="*"/>
                    <DataGridTextColumn Header="Student ID"   Binding="{Binding user_id}"     Width="110"/>
                    <DataGridTextColumn Header="Book"         Binding="{Binding title}"       Width="*"/>
                    <DataGridTextColumn Header="Due Date"     Width="110">
                        <DataGridTextColumn.Binding>
                            <Binding Path="due_date" StringFormat="MMM dd, yyyy"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Days Overdue" Binding="{Binding days_overdue}" Width="110"/>
                    <DataGridTextColumn Header="Penalty"      Binding="{Binding penalty}"      Width="100"/>
                    <DataGridTemplateColumn x:Name="colActions" Header="Actions" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Mark Returned"
                                        Height="24" Padding="8 0"
                                        FontSize="11" Foreground="White"
                                        Background="#16A34A" BorderThickness="0"
                                        Cursor="Hand" Margin="8 0"
                                        Tag="{Binding id}"
                                        Click="btnMarkReturned_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="#15803D"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>