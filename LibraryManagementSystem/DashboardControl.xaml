<UserControl x:Class="LibraryManagementSystem.DashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236*"/>
                <ColumnDefinition Width="11*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Welcome -->
            <StackPanel Grid.Row="0" Margin="0 0 0 16" Grid.ColumnSpan="2">
                <TextBlock x:Name="lblWelcome"
                           FontSize="18" FontWeight="Bold"
                           Foreground="#1E2840"/>
                <TextBlock x:Name="lblDate"
                           FontSize="12" Foreground="#6B7280"
                           Margin="0 4 0 0"/>
            </StackPanel>

            <!-- Summary Cards -->
            <Grid Grid.Row="1" Margin="0 0 0 16" Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Books -->
                <Border Grid.Column="0"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0 0 10 0">
                    <StackPanel>
                        <TextBlock Text="TOTAL BOOKS"
                                   FontSize="10" Foreground="#6B7280"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 6"/>
                        <TextBlock x:Name="lblTotalBooks"
                                   Text="0"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#178AE5"/>
                        <TextBlock x:Name="lblAvailableBooks"
                                   Text="0 available"
                                   FontSize="11" Foreground="#6B7280"
                                   Margin="0 4 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Total Students -->
                <Border Grid.Column="1"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0 0 10 0">
                    <StackPanel>
                        <TextBlock Text="TOTAL STUDENTS"
                                   FontSize="10" Foreground="#6B7280"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 6"/>
                        <TextBlock x:Name="lblTotalStudents"
                                   Text="0"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#16A34A"/>
                        <TextBlock x:Name="lblActiveStudents"
                                   Text="0 active"
                                   FontSize="11" Foreground="#6B7280"
                                   Margin="0 4 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Active Borrows -->
                <Border Grid.Column="2"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16"
                        Margin="0 0 10 0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE BORROWS"
                                   FontSize="10" Foreground="#6B7280"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 6"/>
                        <TextBlock x:Name="lblActiveBorrows"
                                   Text="0"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#CA8A04"/>
                        <TextBlock x:Name="lblOverdueCount"
                                   Text="0 overdue"
                                   FontSize="11" Foreground="#DC2626"
                                   Margin="0 4 0 0"/>
                    </StackPanel>
                </Border>

                <!-- Penalty -->
                <Border Grid.Column="3"
                        Background="White"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="TOTAL PENALTIES"
                                   FontSize="10" Foreground="#6B7280"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 6"/>
                        <TextBlock x:Name="lblTotalPenalties"
                                   Text="₱0.00"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#DC2626"/>
                        <TextBlock Text="₱5.00 / day rate"
                                   FontSize="11" Foreground="#6B7280"
                                   Margin="0 4 0 0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Recent Transactions -->
            <Border Grid.Row="1"
                    Background="White"
                    BorderBrush="#E5E7EB"
                    BorderThickness="1"
                    CornerRadius="8" Grid.ColumnSpan="2" Margin="0,125,0,0" Grid.RowSpan="2">
                <StackPanel>
                    <TextBlock Text="Recent Transactions"
                               FontSize="13" FontWeight="Bold"
                               Foreground="#1E2840"
                               Padding="14 12"/>
                    <Separator Background="#E5E7EB"/>
                    <DataGrid x:Name="dgRecent"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#F3F4F6"
                              BorderThickness="0"
                              Background="White"
                              RowBackground="White"
                              AlternatingRowBackground="#FAFAFA"
                              FontSize="12"
                              ColumnHeaderHeight="36"
                              RowHeight="36"
                              HeadersVisibility="Column">

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F9FAFB"/>
                                <Setter Property="Foreground" Value="#6B7280"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="12 0"/>
                                <Setter Property="BorderBrush" Value="#E5E7EB"/>
                                <Setter Property="BorderThickness" Value="0 0 0 1"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="12 0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#EFF6FF"/>
                                        <Setter Property="Foreground" Value="#1E40AF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Student"    Binding="{Binding full_name}" Width="*"/>
                            <DataGridTextColumn Header="Student ID" Binding="{Binding user_id}"   Width="110"/>
                            <DataGridTextColumn Header="Book"       Binding="{Binding title}"     Width="*"/>
                            <DataGridTextColumn Header="Borrow Date" Width="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="borrow_date" StringFormat="MMM dd, yyyy"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Due Date" Width="110">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="due_date" StringFormat="MMM dd, yyyy"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="6 2"
                                                HorizontalAlignment="Left"
                                                Margin="8 0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF9C3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding status}" Value="returned">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding status}" Value="overdue">
                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Borrowed"/>
                                                        <Setter Property="Foreground" Value="#CA8A04"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding status}" Value="returned">
                                                                <Setter Property="Text" Value="Returned"/>
                                                                <Setter Property="Foreground" Value="#16A34A"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding status}" Value="overdue">
                                                                <Setter Property="Text" Value="Overdue"/>
                                                                <Setter Property="Foreground" Value="#DC2626"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>