<UserControl x:Class="LibraryManagementSystem.ActivityLogsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FA"
             FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top bar: Search + Filter -->
        <Grid Grid.Row="0" Margin="0 0 0 14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="5"
                    Padding="8 0"
                    Margin="0 0 10 0">
                <TextBox x:Name="txtSearch"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Height="32"
                         FontSize="12"
                         Foreground="#374151"
                         TextChanged="txtSearch_TextChanged">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <VisualBrush AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                                <VisualBrush.Visual>
                                                    <TextBlock Text="Search action or detail..."
                                                               Foreground="#9CA3AF"
                                                               FontSize="12"
                                                               Margin="2 0"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>

            <!-- Filter by action -->
            <Border Grid.Column="1"
                    Background="White"
                    BorderBrush="#D1D5DB"
                    BorderThickness="1"
                    CornerRadius="5"
                    Margin="0 0 10 0">
                <ComboBox x:Name="cmbFilter"
                          Height="32"
                          FontSize="12"
                          BorderThickness="0"
                          Background="Transparent"
                          VerticalContentAlignment="Center"
                          Padding="8 0"
                          SelectionChanged="cmbFilter_SelectionChanged">
                    <ComboBoxItem Content="All Actions" IsSelected="True"/>
                    <ComboBoxItem Content="Login"/>
                    <ComboBoxItem Content="Logout"/>
                    <ComboBoxItem Content="Book Added"/>
                    <ComboBoxItem Content="Book Updated"/>
                    <ComboBoxItem Content="Book Deleted"/>
                    <ComboBoxItem Content="Borrower Added"/>
                    <ComboBoxItem Content="Borrower Updated"/>
                    <ComboBoxItem Content="Borrower Deleted"/>
                    <ComboBoxItem Content="Book Borrowed"/>
                    <ComboBoxItem Content="Book Returned"/>
                    <ComboBoxItem Content="Penalty Settled"/>
                </ComboBox>
            </Border>

            <!-- Clear/Refresh button -->
            <Button Grid.Column="2"
                    Content="↺ Refresh"
                    Height="34"
                    Padding="14 0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Background="#178AE5"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="btnRefresh_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1279CC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Table -->
        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E5E7EB"
                BorderThickness="1"
                CornerRadius="8">
            <DataGrid x:Name="dgLogs"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3F4F6"
                      BorderThickness="0"
                      Background="White"
                      RowBackground="White"
                      AlternatingRowBackground="#FAFAFA"
                      FontSize="12"
                      ColumnHeaderHeight="38"
                      RowHeight="36">

                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F9FAFB"/>
                        <Setter Property="Foreground" Value="#6B7280"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="12 0"/>
                        <Setter Property="BorderBrush" Value="#E5E7EB"/>
                        <Setter Property="BorderThickness" Value="0 0 0 1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="12 0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EFF6FF"/>
                                <Setter Property="Foreground" Value="#1E40AF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date &amp; Time" Width="150">
                        <DataGridTextColumn.Binding>
                            <Binding Path="log_time" StringFormat="MMM dd, yyyy hh:mm tt"/>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="User"   Binding="{Binding full_name}" Width="140"/>
                    <DataGridTextColumn Header="Action" Binding="{Binding action}"    Width="140"/>
                    <DataGridTextColumn Header="Detail" Binding="{Binding detail}"    Width="*"/>
                </DataGrid.Columns>     
            </DataGrid>
        </Border>
    </Grid>
</UserControl>