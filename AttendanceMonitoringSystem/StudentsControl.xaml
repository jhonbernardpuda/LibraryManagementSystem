<UserControl x:Class="AttendanceMonitoringSystem.StudentsControl"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="White" Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- INPUT FIELDS -->
        <StackPanel Orientation="Horizontal" Margin="5">
            <StackPanel Margin="5">
                <TextBlock Text="Student ID" FontSize="11" Foreground="Gray"/>
                <TextBox x:Name="txtID" Width="120"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="First Name" FontSize="11" Foreground="Gray"/>
                <TextBox x:Name="txtFirst" Width="120"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Last Name" FontSize="11" Foreground="Gray"/>
                <TextBox x:Name="txtLast" Width="120"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Program" FontSize="11" Foreground="Gray"/>
                <TextBox x:Name="txtProgram" Width="120"/>
            </StackPanel>
            <StackPanel Margin="5">
                <TextBlock Text="Year &amp; Section" FontSize="11" Foreground="Gray"/>
                <TextBox x:Name="txtYearSection" Width="120"/>
            </StackPanel>
            <StackPanel Margin="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                
                <Button Content="Add Student"
                Width="110"
                Margin="0,0,5,0"
                Click="Add_Click"
                Background="Green"
                Foreground="White"/>
               
                <Button Content="Clear"
                        Width="80"
                        Click="Clear_Click"
                        Background="DarkGray"
                        Foreground="White"/>
            </StackPanel>
        </StackPanel>

        <!-- BUTTON FUNCTIONS -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="5">
            <TextBox x:Name="txtSearch"
                     Width="250"
                     Height="30"
                     Margin="5"/>
            <Button Content="Search"
                    Width="100"
                    Margin="5"
                    Click="Search_Click"/>
            <Button Content="Refresh"
                    Width="100"
                    Margin="5"
                    Click="Refresh_Click"/>
            <Button Content="Delete"
                    Width="100"
                    Margin="5"
                    Background="Red"
                    Foreground="White"
                    Click="Delete_Click"/>
        </StackPanel>

        <!-- STUDENT GRID AND TABLE -->
        <DataGrid x:Name="StudentsGrid"
                  Grid.Row="2"
                  Margin="5"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  
                  SelectionChanged="StudentsGrid_SelectionChanged"
                  RowEditEnding="StudentsGrid_RowEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Student ID" Binding="{Binding student_id}" Width="*"/>
                <DataGridTextColumn Header="First Name" Binding="{Binding first_name}" Width="*"/>
                <DataGridTextColumn Header="Last Name" Binding="{Binding last_name}" Width="*"/>
                <DataGridTextColumn Header="Program" Binding="{Binding program}" Width="*"/>
                <DataGridTextColumn Header="Year/Section" Binding="{Binding year_section}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </Grid>
</UserControl>