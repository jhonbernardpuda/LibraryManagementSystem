<UserControl x:Class="AttendanceMonitoringSystem.ReportsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="White" Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Top Filter -->
        <StackPanel Orientation="Horizontal" Margin="10">

            <DatePicker x:Name="dpReportDate"
                        Width="150"
                        Margin="5"/>

            <Button Content="Load Report"
                    Width="120"
                    Margin="5"
                    Click="LoadReport_Click"/>

        </StackPanel>

        <!-- Report Table -->
        <DataGrid x:Name="ReportGrid"
                  Grid.Row="1"
                  Margin="10"
                  AutoGenerateColumns="False"
                  IsReadOnly="True">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Student ID"
                                     Binding="{Binding student_id}"
                                     Width="*"/>

                <DataGridTextColumn Header="First Name"
                                     Binding="{Binding first_name}"
                                     Width="*"/>

                <DataGridTextColumn Header="Last Name"
                                     Binding="{Binding last_name}"
                                     Width="*"/>

                <DataGridTextColumn Header="Program"
                                     Binding="{Binding program}"
                                     Width="*"/>

                <DataGridTextColumn Header="Year/Section"
                                     Binding="{Binding year_section}"
                                     Width="*"/>

                <DataGridTextColumn Header="Status"
                                     Binding="{Binding status}"
                                     Width="*"/>

                <DataGridTextColumn Header="Date"
                                     Binding="{Binding date}"
                                     Width="*"/>

            </DataGrid.Columns>

        </DataGrid>

    </Grid>
</UserControl>