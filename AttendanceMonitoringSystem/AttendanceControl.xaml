<UserControl x:Class="AttendanceMonitoringSystem.AttendanceControl"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="White" Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top -->
        <StackPanel Orientation="Horizontal" Margin="10">

            <DatePicker x:Name="dpDate"
Width="150"
Margin="5"/>

            <Button Content="Load Students"
Width="120"
Margin="5"
Click="LoadStudents_Click"/>

        </StackPanel>

        <!-- Table -->
        <DataGrid x:Name="AttendanceGrid"
Grid.Row="1"
Margin="10"
AutoGenerateColumns="False">

            <DataGrid.Columns>

                <DataGridTextColumn Header="Student ID"
Binding="{Binding student_id}" Width="*"/>

                <DataGridTextColumn Header="First Name"
Binding="{Binding first_name}" Width="*"/>

                <DataGridTextColumn Header="Last Name"
Binding="{Binding last_name}" Width="*"/>

                <DataGridTextColumn Header="Program"
Binding="{Binding program}" Width="*"/>

                <DataGridTextColumn Header="Year/Section"
Binding="{Binding year_section}" Width="*"/>

                <DataGridTemplateColumn Header="Present">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <RadioButton Content="Present"
                         GroupName="{Binding student_id}"
                         Checked="Present_Checked"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Absent">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <RadioButton Content="Absent"
                         GroupName="{Binding student_id}"
                         Checked="Absent_Checked"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>

        </DataGrid>

        <!-- Save -->
        <Button x:Name="btnSave"
Content="Save Attendance"
Grid.Row="2"                
Height="35"
Width="150"
Margin="10"
HorizontalAlignment="Right"
Background="#2E7D32"
Foreground="White"
Click="Save_Click"/>

    </Grid>
</UserControl>