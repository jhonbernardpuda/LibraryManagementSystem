<UserControl x:Class="AttendanceMonitoringSystem.DashboardControl"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="#F5F5F5" Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Dashboard"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="5"/>

        <UniformGrid Grid.Row="1" Columns="3" Margin="0 15">

            <Border Background="White" Margin="5" Padding="20">
                <StackPanel>
                    <TextBlock Text="Total Students"/>
                    <TextBlock x:Name="lblTotal" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" Margin="5" Padding="20">
                <StackPanel>
                    <TextBlock Text="Present Today"/>
                    <TextBlock x:Name="lblPresent" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="White" Margin="5" Padding="20">
                <StackPanel>
                    <TextBlock Text="Absent Today"/>
                    <TextBlock x:Name="lblAbsent" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

        </UniformGrid>

    </Grid>
</UserControl>