<Window x:Class="AttendanceMonitoringSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Attendance Monitoring System" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Background="#0F2A44">
            <StackPanel>

                <TextBlock Text="ATTENDANCE SYSTEM"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="Bold"
                           Margin="20"/>

                <Button x:Name="btnDashboard"
                        Content="Dashboard" 
                        Height="40" 
                        Margin="10"
                        Click="Dashboard_Click"/>

                <Button x:Name="btnStudents"
                    Content="Students" 
                        Height="40" 
                        Margin="10"
                        Click="Students_Click"/>

                <Button  x:Name="btnAttendance"
                    Content="Attendance" 
                        Height="40" 
                        Margin="10"
                        Click="Attendance_Click"/>

                <Button x:Name="btnReports"
                    Content="Reports" 
                        Height="40" 
                        Margin="10"
                        Click="Reports_Click"/>

                <Button  x:Name="btnLogout"
                    Content="Logout"
                        Height="40"
                        Margin="10"
                        Click="Logout_Click"
                        Background="#D32F2F"
                        Foreground="White"/>
                

            </StackPanel>
        </Grid>

        <!-- Content Area -->
        <Grid Grid.Column="1" Background="#F5F7FA">

            <Frame x:Name="MainFrame"/>

        </Grid>

    </Grid>
</Window>